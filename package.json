{
  "name": "gemini-unofficial-api",
  "version": "1.0.0",
  "description": "Unofficial Google Gemini API client with MCP server - no login required",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "gemini": "./src/cli.js",
    "gemini-mcp": "./src/mcp.js"
  },
  "scripts": {
    "start": "node --max-http-header-size=65536 src/cli.js",
    "mcp": "node --max-http-header-size=65536 src/mcp.js",
    "test": "node --max-http-header-size=65536 src/test.js"
  },
  "dependencies": {
    "mime-types": "^3.0.2",
    "node-fetch": "^3.3.2"
  },
  "keywords": [
    "gemini",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "bard",
    "google",
    "ai"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/etrnkz/gemini-unofficial-api.git"
  },
  "author": "etrnkz",
  "files": [
    "src",
    "media",
    "docs",
    "opencode.json",
    ".opencode",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT"
}
